# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it's in .gitignore.

# Neon PostgreSQL connection string (get from https://console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Admin panel password (make this strong — it protects /admin)
ADMIN_PASSWORD=your-strong-password-here

# Arcjet key (get from https://arcjet.com — free, for bot/rate-limit protection)
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxxxxxx
